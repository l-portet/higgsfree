# higgsfree environment. Next.js loads `.env` and `.env.local` (git-ignored) itself.
# On Vercel, set these in the project's Environment Variables, or let the integrations below do it.

# Your OpenRouter API key. Optional: you can also paste it in Settings inside the app
# (stored in the database). If set here, it takes precedence.
OPENROUTER_API_KEY=

# ---- storage ----------------------------------------------------------------------------------
# Leave both groups empty for local development: media and a SQLite database go to DATA_DIR.
# On Vercel both are required (the filesystem there is read-only):
#   vercel blob create-store higgsfree-media     → BLOB_READ_WRITE_TOKEN (a *public* store)
#   vercel integration add tursocloud/database   → TURSO_DATABASE_URL + TURSO_AUTH_TOKEN
# then `vercel env pull .env.local` to use the same stores from `pnpm dev`.
# BLOB_READ_WRITE_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Where media + the SQLite database live when the two above are unset (default ./data)
DATA_DIR=./data

# ---- app ---------------------------------------------------------------------------------------
# Public url of the app. Used for the OpenRouter attribution header and social cards; its host
# is always an allowed hostname. On Vercel it defaults to the production domain.
APP_URL=http://localhost:3000
APP_NAME=higgsfree

# Extra hostnames the server accepts in `Host` / `Origin` (comma-separated, no ports).
# localhost, 127.0.0.1, ::1, the host of APP_URL and every url Vercel assigns to a deployment are
# always allowed; a custom domain on Vercel needs no entry either (requests reach the app only
# through its own domains there). Add a LAN IP / Tailscale name for other devices in local dev;
# `*` disables the check.
# ALLOWED_HOSTS=192.168.1.20,studio.tailnet.ts.net

# Ceiling on pending + running generations across the instance (default 8). Requests above it get a 429.
# MAX_ACTIVE_JOBS=8

# Advanced: override the OpenRouter API base (used by the integration tests / proxies)
# OPENROUTER_BASE_URL=https://openrouter.ai

# Everything here is optional and read only by `next build` (inlined into the pages).
# The app runs in the browser and the keys are entered in the app; the server only passes ByteDance calls through.

# Public origin of the site: the base for the canonical links, the social-card urls, robots.txt and
# the sitemap. Default: https://higgsfree.com. Only override it for a deploy on another domain --
# pointing the canonicals at a preview url is how a preview ends up competing with production.
# APP_URL=http://localhost:3000

# Where OpenRouter calls go (proxies only). Default: https://openrouter.ai
# NEXT_PUBLIC_OPENROUTER_BASE_URL=

# Sent to OpenRouter as X-Title for app attribution. Default: higgsfree
# NEXT_PUBLIC_APP_NAME=

# Microsoft Clarity project that production builds report to. Default: z9kdvhwh47
# NEXT_PUBLIC_CLARITY_ID=

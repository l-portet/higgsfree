# Open Higgsfield environment
# Your OpenRouter API key. Optional: you can also paste it in Settings inside the app
# (stored in the local SQLite database). If set here, it takes precedence.
OPENROUTER_API_KEY=

# Server port (default 8787)
PORT=8787

# Interface the server binds to (default 127.0.0.1, this machine only). There is no login, so
# only set 0.0.0.0 to reach the app from other devices on a private LAN / Tailscale, and list
# that hostname or IP in ALLOWED_HOSTS below. The Docker image sets this to 0.0.0.0 itself.
# HOST=127.0.0.1

# Where generated media + the SQLite database live (default ./data)
DATA_DIR=./data

# Optional attribution headers sent to OpenRouter (shown on openrouter.ai rankings)
APP_URL=http://localhost:8787
APP_NAME=Open Higgsfield

# Hostnames the server accepts in `Host` / `Origin` (comma-separated, no ports). localhost,
# 127.0.0.1, ::1 and the host of APP_URL are always allowed. Add your LAN IP / Tailscale name
# to reach the app from another device; `*` disables the check (only behind a trusted proxy).
# Behind a reverse proxy: only the received `Host` is checked (X-Forwarded-* headers are never
# consulted), so keep the browser's Host (nginx: `proxy_set_header Host $host;`; Caddy and
# Traefik do this by default) and list your public hostname here or set it as APP_URL.
# ALLOWED_HOSTS=192.168.1.20,studio.tailnet.ts.net

# Ceiling on pending + running generations across the instance (default 8). Requests above it get a 429.
# MAX_ACTIVE_JOBS=8

# Advanced: override the OpenRouter API base (used by the integration tests / proxies)
# OPENROUTER_BASE_URL=https://openrouter.ai
